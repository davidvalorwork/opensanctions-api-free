# Desarrollo local
MONGO_URI=mongodb://localhost:27017
MONGO_DB=opensanctions
PORT=3000

# Modo de búsqueda:
# - '1'/'true'/'yes' => lite (busca solo por `id` y `caption`, sin `searchableText`/properties)
# - vacío => full (busca también sobre `searchableText` derivado de properties)
OPENSANCTIONS_SEARCH_LITE=

# Búsqueda: tope de entidades y de relaciones en lote (opcional)
# SEARCH_MAX_RESULTS=200
# SEARCH_REL_BATCH_LIMIT=2000

# RapidAPI (cuando publicas la API en RapidAPI): true/1/yes/on activa CORS y trust proxy.
# Si defines RAPIDAPI_PROXY_SECRET, debe coincidir con el "Proxy Secret" del portal (cabecera X-RapidAPI-Proxy-Secret); /health queda exento.
# rapid_api=
# RAPIDAPI_PROXY_SECRET=

# Adjudicación (POST /screen). Sin ANTHROPIC_API_KEY el endpoint responde 501
# y el resto de la API sigue funcionando.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=medium          # low..max — palanca principal de coste/latencia
# ANTHROPIC_TIMEOUT_MS=60000       # por intento; el SDK reintenta, así que el peor caso es 3x
# ANTHROPIC_MAX_RETRIES=2

# Protección de /screen: es el único endpoint que gasta dinero por llamada.
# Si SCREEN_API_KEY está definida, se exige la cabecera x-api-key y se aplica
# límite de tasa por clave. Sin ella, el endpoint queda abierto (solo local).
# El contador vive en memoria del proceso: en multi-instancia el techo efectivo
# es límite × instancias. Ver src/infrastructure/screenGuard.js.
# SCREEN_API_KEY=
# SCREEN_RATE_LIMIT=30
# SCREEN_RATE_WINDOW_MS=60000

# Producción (contenedor Docker): pasar MONGO_URI al run, ej.:
# -e MONGO_URI=mongodb://host.docker.internal:27017
# -e MONGO_URI=mongodb://mongo:27017   (si mongo está en la misma red Docker)
# -e MONGO_DB=analytikoDB3   (opcional, si usas otra base)
